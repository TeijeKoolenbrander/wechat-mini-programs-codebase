    },
    {
      "keys": [
        [
          "openid",
          "asc"
        ],
        [
          "groupRef",
          "asc"
        ]
      ],
      "for": "getBoard membership check"
    },
    {
      "keys": [
        [
          "lastSeen",
          "asc"
        ]
      ],
      "for": "cleanup retention"
    }
  ],
  "rate_limits": [
